{
  "name": "playwright-bdd-ai-framework",
  "version": "2.0.0",
  "private": true,
  "description": "Playwright BDD framework with TypeScript and Cucumber",
  "scripts": {
    "demo": "tsx demo/server.ts",
    "test": "cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:negative": "cucumber-js --tags @negative",
    "test:login": "cucumber-js --tags @login",
    "typecheck": "tsc --noEmit",
    "clean": "tsx scripts/clean.ts"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright": "^1.52.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
